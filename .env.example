# Ejecuta php bin/arca install; no subas el archivo .env real.
# Los enlaces oficiales del asistente pueden reemplazarse con variables
# ARCA_DOC_CERTIFICATES_URL, ARCA_DOC_WSASS_URL,
# ARCA_DOC_WSASS_CERTIFICATE_URL, ARCA_DOC_WSASS_AUTHORIZATION_URL,
# ARCA_DOC_PRODUCTION_CERTIFICATE_URL,
# ARCA_DOC_PRODUCTION_AUTHORIZATION_URL y ARCA_DOC_BILLING_URL.
ARCA_ENVIRONMENT=homologacion
ARCA_CUIT=20123456786
ARCA_POINT_OF_SALE=1
ARCA_CERT_PATH=storage/certificados/homologacion/certificado.crt
ARCA_KEY_PATH=storage/certificados/homologacion/privada.key
ARCA_STORAGE_PATH=storage
ARCA_LOG_LEVEL=warning
ARCA_DEBUG=false
ARCA_CONNECTION_TIMEOUT=20
ARCA_REQUEST_TIMEOUT=30
